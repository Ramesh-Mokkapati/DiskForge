END

// -------------------------------------------------------------------------
// IDD_BADSECTORSCAN  (CBadSectorScanDialog)
// IDC_BSS_STATIC_MAP is a placeholder LTEXT; OnInitDialog destroys it and
// creates the real CScanMapView at the same rect.
// -------------------------------------------------------------------------
IDD_BADSECTORSCAN DIALOGEX 0, 0, 400, 320
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX |
      WS_SIZEBOX | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Bad Sector Scan"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Drive:", IDC_STATIC, 7, 7, 29, 9
    COMBOBOX        IDC_BSS_COMBO_DRIVE, 7, 18, 386, 123, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    AUTORADIOBUTTON "Whole disk",       IDC_BSS_RADIO_WHOLE,   7, 38,  57, 11, WS_GROUP
    AUTORADIOBUTTON "Single partition", IDC_BSS_RADIO_PART,   70, 38,  80, 11
    AUTORADIOBUTTON "LBA range",        IDC_BSS_RADIO_RANGE, 155, 38,  74, 11
    PUSHBUTTON      "Choose Partition...", IDC_BSS_BTN_CHOOSE_PART,   7, 53,  80, 15
    LTEXT           "Start:",  IDC_BSS_STATIC_RANGE_START_LBL,  7, 55,  51, 10
    EDITTEXT        IDC_BSS_EDIT_RANGE_START,                  59, 54,  62, 12
    LTEXT           "Count:",  IDC_BSS_STATIC_RANGE_COUNT_LBL, 127, 55,  51, 10
    EDITTEXT        IDC_BSS_EDIT_RANGE_COUNT,                  179, 54,  67, 12
    LTEXT           "", IDC_BSS_STATIC_PART, 7, 71, 386, 10
    LTEXT           "Sector Map:", IDC_STATIC, 7, 86, 46, 9
    LTEXT           "", IDC_BSS_STATIC_MAP, 7, 96, 386, 62
    LTEXT           "", IDC_BSS_STATIC_STATUS, 7, 161, 386, 11
    LTEXT           "Bad Sectors:", IDC_STATIC, 7, 176, 46, 9
    CONTROL         "", IDC_BSS_LIST_BAD, "SysListView32",
                    LVS_REPORT|LVS_SHOWSELALWAYS|WS_BORDER|WS_CHILD|WS_VISIBLE|WS_TABSTOP,
                    7, 187, 386, 106
    PUSHBUTTON      "Start Scan",        IDC_BSS_BTN_START,    7, 299,  63, 16
    PUSHBUTTON      "Stop",              IDC_BSS_BTN_STOP,    75, 299,  63, 16
    PUSHBUTTON      "Attempt Repair...", IDC_BSS_BTN_REPAIR,  144, 299,  91, 16
    PUSHBUTTON      "Close",             IDC_BSS_BTN_CLOSE,   342, 299,  51, 16
END

