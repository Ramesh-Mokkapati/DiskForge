// DiskForge.rc - Application resources
#include "resource.h"
#include <winres.h>
#include "afxres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// -------------------------------------------------------------------------
// Icons and bitmaps (pane/caption assets from the NewTest framework)
// -------------------------------------------------------------------------
IDR_MAINFRAME           ICON    "res\\DiskForge.ico"
IDI_OUTPUT_WND          ICON    "res\\output_wnd.ico"
IDI_OUTPUT_WND_HC       ICON    "res\\output_wnd_hc.ico"
IDI_PROPERTIES_WND      ICON    "res\\properties_wnd.ico"
IDI_PROPERTIES_WND_HC   ICON    "res\\properties_wnd_hc.ico"

IDB_MAIN                BITMAP  "res\\main.bmp"
IDB_INFO                BITMAP  "res\\info.bmp"
IDR_PROPERTIES          BITMAP  "res\\properties.bmp"
IDB_PROPERTIES_HC       BITMAP  "res\\properties_hc.bmp"
IDB_PAGES               BITMAP  "res\\pages.bmp"
IDB_PAGES_HC            BITMAP  "res\\pages_hc.bmp"
IDB_PAGES_SMALL         BITMAP  "res\\pages_small.bmp"
IDB_PAGES_SMALL_HC      BITMAP  "res\\pages_small_hc.bmp"

IDR_PROPERTIES TOOLBAR 16, 15
BEGIN
    BUTTON      ID_EXPAND_ALL
    BUTTON      ID_SORTPROPERTIES
END

// -------------------------------------------------------------------------
// Menus. IDR_MAINFRAME is required by CFrameWnd::LoadFrame; the ribbon
// replaces it on screen.
// -------------------------------------------------------------------------
IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Refresh Disks",              ID_DISK_REFRESH
        MENUITEM "&Open Disk Image...",         ID_DISK_OPEN_IMAGE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About DiskForge...",         ID_APP_ABOUT
    END
END

IDR_THEME_MENU MENU
BEGIN
    MENUITEM "Office 2007 (&Blue Style)",       ID_VIEW_APPLOOK_OFF_2007_BLUE
    MENUITEM "Office 2007 (B&lack Style)",      ID_VIEW_APPLOOK_OFF_2007_BLACK
    MENUITEM "Office 2007 (&Silver Style)",     ID_VIEW_APPLOOK_OFF_2007_SILVER
    MENUITEM "Office 2007 (&Aqua Style)",       ID_VIEW_APPLOOK_OFF_2007_AQUA
    MENUITEM "Win&dows 7",                      ID_VIEW_APPLOOK_WINDOWS_7
    MENUITEM SEPARATOR
    MENUITEM "Visual Studio 200&5",             ID_VIEW_APPLOOK_VS_2005
    MENUITEM "Visual Studio 200&8",             ID_VIEW_APPLOOK_VS_2008
    MENUITEM "Office 200&3",                    ID_VIEW_APPLOOK_OFF_2003
    MENUITEM "Office &XP",                      ID_VIEW_APPLOOK_OFF_XP
    MENUITEM "&Windows XP",                     ID_VIEW_APPLOOK_WIN_XP
    MENUITEM "Windows &2000",                   ID_VIEW_APPLOOK_WIN_2000
END

IDR_POPUP_BROWSER MENU
BEGIN
    POPUP "Browser"
    BEGIN
        MENUITEM "&Open",                       ID_BROWSE_OPEN
        MENUITEM "&Recover...",                 ID_BROWSE_RECOVER
        MENUITEM SEPARATOR
        MENUITEM "Show &Entry / Record in Sector View", ID_BROWSE_SHOW_META
        MENUITEM "Show &Data in Sector View",   ID_BROWSE_SHOW_DATA
    END
END

IDR_OUTPUT_POPUP MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "&Copy",                       ID_EDIT_COPY
        MENUITEM "C&lear",                      ID_EDIT_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "&Hide",                       ID_VIEW_OUTPUTWND
    END
END

// -------------------------------------------------------------------------
// Strings
// -------------------------------------------------------------------------
STRINGTABLE
BEGIN
    IDR_MAINFRAME           "DiskForge\n\nDiskForge\n\n\nDiskForge.Document\nDiskForge Document"
    AFX_IDS_APP_TITLE       "DiskForge"
    AFX_IDS_IDLEMESSAGE     "Ready"
END

STRINGTABLE
BEGIN
    IDS_OUTPUT_WND          "Output"
    IDS_PROPERTIES_WND      "Properties"
    IDS_HEX_WND             "Sector View"
    IDS_SHORTCUTS           "Tools"
    IDS_OUTLOOKBAR          "Tools Bar"
    IDS_PAGE_TOOLS          "Disk Tools"
    IDS_PAGE_RECOVERY       "Recovery"
    IDS_PAGE_BOOT           "Boot && Firmware"
    IDS_CAPTION_TEXT        "The System Browser and file recovery only read the source disk. Tools marked (writes) can change disks and ask for confirmation first."
    IDS_CAPTION_BUTTON      "Refresh Disks"
    IDS_CAPTION_BUTTON_TIP  "Re-read the list of physical disks"
    IDS_CAPTION_IMAGE_TIP   "Read-only browsing"
    IDS_CAPTION_IMAGE_TEXT  "DiskForge reads raw sectors and needs Administrator rights."
    IDS_LOG_TAB             "Log"
    IDS_STATUS_PANE1        "Ready"
    IDS_STATUS_PANE2        "No disk"
END

STRINGTABLE
BEGIN
    ID_DISK_REFRESH         "Re-read the list of physical disks\nRefresh Disks"
    ID_DISK_OPEN_IMAGE      "Browse a raw disk image file (for example one saved by Disk Copy), read-only\nOpen Disk Image"
    ID_BROWSE_SHOW_DELETED  "Show deleted files and folders in the System Browser\nShow Deleted"
    ID_BROWSE_DELETED_ONLY  "List only deleted entries\nDeleted Only"
    ID_BROWSE_RECOVER       "Copy the selected files or folders (live or deleted) to a folder on another disk\nRecover"
    ID_BROWSE_SHOW_META     "Show the selected item's directory entry or MFT record in the Sector View\nShow Record"
    ID_BROWSE_SHOW_DATA     "Show the selected file's first data sector in the Sector View\nShow Data"
    ID_BROWSE_OPEN          "Open the selected folder or partition\nOpen"
    ID_BROWSE_UP            "Go to the parent item\nUp"
    ID_SECTOR_FIRST         "First sector of the disk\nFirst"
    ID_SECTOR_PREV          "Previous sector\nPrevious"
    ID_SECTOR_NEXT          "Next sector\nNext"
    ID_SECTOR_LAST          "Last sector of the disk\nLast"
    ID_SECTOR_EDIT          "Sector number (LBA) to show - decimal or 0x hex; press Enter\nLBA"
    ID_SECTOR_GOTO          "Show the sector typed in the LBA box\nGo To"
    ID_TOOL_PARTITIONS      "Show the partition table of a disk\nPartition Table"
    ID_TOOL_DISKCOPY        "Clone a disk or partition to another disk or an image file (writes)\nDisk Copy"
    ID_TOOL_BADSECTOR       "Surface-scan a disk for unreadable sectors\nBad Sector Scan"
    ID_TOOL_SMART           "Read the S.M.A.R.T. health data reported by a drive\nDisk Health"
    ID_TOOL_MBRGPT          "Convert a disk from MBR to GPT in place (writes)\nMBR to GPT"
    ID_TOOL_PARTEDIT        "Edit, delete or extend partition table entries (writes)\nPartition Editor"
    ID_TOOL_WIPE            "Overwrite a whole disk or partition (writes)\nWipe Disk"
    ID_TOOL_EFIBOOT         "Manage UEFI boot entries in NVRAM (writes)\nUEFI Boot"
    ID_TOOL_LOSTPART        "Search unallocated space for lost partitions\nLost Partitions"
    ID_TOOL_FILERECOVERY    "Classic FAT32 file recovery dialog\nFAT32 Recovery"
    ID_VIEW_OUTPUTWND       "Show or hide the Output pane\nOutput"
    ID_VIEW_PROPERTIESWND   "Show or hide the Properties pane\nProperties"
    ID_VIEW_HEXWND          "Show or hide the Sector View pane\nSector View"
    ID_VIEW_NAVIGATION      "Show or hide the Tools bar\nTools Bar"
    ID_VIEW_CAPTION_BAR     "Show or hide the caption bar\nCaption Bar"
    ID_EXPAND_ALL           "Expand all groups\nExpand All"
    ID_SORTPROPERTIES       "Sort alphabetically\nSort"
END

// -------------------------------------------------------------------------
// IDD_ABOUTBOX
// -------------------------------------------------------------------------
IDD_ABOUTBOX DIALOGEX 0, 0, 230, 82
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About DiskForge"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME, IDC_STATIC, 14, 14, 21, 20
    LTEXT           "DiskForge - raw disk browser, recovery and repair tools", IDC_STATIC, 42, 14, 180, 8, SS_NOPREFIX
    LTEXT           "System Browser: partitions, boot records, FAT / MFT and deleted-file recovery.", IDC_STATIC, 42, 28, 180, 18
    DEFPUSHBUTTON   "OK", IDOK, 173, 61, 50, 14, WS_GROUP
END

// -------------------------------------------------------------------------
// IDD_PARTITIONS  (CPartitionDialog)
// -------------------------------------------------------------------------
IDD_PARTITIONS DIALOGEX 0, 0, 434, 258
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX |
      WS_SIZEBOX | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Partition Table"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PART_STATIC_SUMMARY,   5,   5, 425, 22
    CONTROL         "", IDC_PART_LIST, "SysListView32",
                    LVS_REPORT|LVS_SHOWSELALWAYS|WS_BORDER|WS_CHILD|WS_VISIBLE|WS_TABSTOP,
                    5, 31, 425, 202
    PUSHBUTTON      "Go to Sector",  IDC_PART_BTN_GOTO,    5, 238,  91, 16
    PUSHBUTTON      "Close",         IDC_PART_BTN_CLOSE, 377, 238,  53, 16
END

// -------------------------------------------------------------------------
// IDD_CONFIRM_TEXT  (CConfirmTextDialog)  — fixed-size, no resize
// -------------------------------------------------------------------------
IDD_CONFIRM_TEXT DIALOGEX 0, 0, 297, 148
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Confirm"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CONFIRM_STATIC_MSG,   7,   7, 283, 62, SS_LEFT|SS_SUNKEN
    LTEXT           "", IDC_CONFIRM_STATIC_HINT,  7,  74, 283, 18
    EDITTEXT        IDC_CONFIRM_EDIT,             7,  97, 283, 15, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",     IDC_CONFIRM_BTN_OK,     201, 121,  40, 16
    PUSHBUTTON      "Cancel", IDC_CONFIRM_BTN_CANCEL, 246, 121,  45, 16
END

// -------------------------------------------------------------------------
// IDD_DISKCOPY  (CDiskCopyDialog)
// -------------------------------------------------------------------------
IDD_DISKCOPY DIALOGEX 0, 0, 430, 310
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX |
      WS_SIZEBOX | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Disk Copy"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Source:",  IDC_DC_STATIC_SRC_HDR, 8, 6, 36, 14
    AUTORADIOBUTTON "Drive/Image file", IDC_DC_RADIO_SRC_TYPE_DRIVE, 46, 6, 100, 14, WS_GROUP
    AUTORADIOBUTTON "File",             IDC_DC_RADIO_SRC_TYPE_FILE, 150, 6,  50, 14
    COMBOBOX        IDC_DC_COMBO_SRC,     8, 24, 280, 120, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    EDITTEXT        IDC_DC_EDIT_SRC_FILE, 8, 24, 220,  14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",     IDC_DC_BTN_BROWSE_SRC,  236, 24,  52, 14
    AUTORADIOBUTTON "Whole disk",       IDC_DC_RADIO_SRC_WHOLE,   8, 44, 80, 14, WS_GROUP
    AUTORADIOBUTTON "Single partition", IDC_DC_RADIO_SRC_PART,   96, 44, 90, 14
    PUSHBUTTON      "Choose Partition...", IDC_DC_BTN_CHOOSE_PART, 190, 42, 100, 16
    LTEXT           "", IDC_DC_STATIC_PART,  8, 62, 414, 12
    LTEXT           "Destination:", IDC_DC_STATIC_DST_HDR, 8, 76, 60, 14
    AUTORADIOBUTTON "Physical drive", IDC_DC_RADIO_DST_DISK,   8, 90,  80, 14, WS_GROUP
    AUTORADIOBUTTON "Image file",     IDC_DC_RADIO_DST_FILE,  96, 90,  70, 14
    COMBOBOX        IDC_DC_COMBO_DST,     8, 108, 280, 120, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    EDITTEXT        IDC_DC_EDIT_DST_FILE, 8, 108, 220,  14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",     IDC_DC_BTN_BROWSE,     236, 108,  52, 14
    AUTORADIOBUTTON "Whole disk",       IDC_DC_RADIO_DST_WHOLE,   8, 126, 80, 14, WS_GROUP
    AUTORADIOBUTTON "Single partition", IDC_DC_RADIO_DST_PART,   96, 126, 90, 14
    PUSHBUTTON      "Choose Partition...", IDC_DC_BTN_CHOOSE_DST_PART, 190, 124, 120, 16
    LTEXT           "", IDC_DC_STATIC_DST_PART,   8, 142, 414, 12
    PUSHBUTTON      "Refresh Drive List", IDC_DC_BTN_REFRESH, 8, 158, 100, 16
    LTEXT           "", IDC_DC_STATIC_SUMMARY,    8, 180, 414, 36
    CONTROL         "", IDC_DC_PROGRESS, "msctls_progress32", PBS_SMOOTH|WS_CHILD|WS_VISIBLE,
                     8, 222, 414, 12
    LTEXT           "", IDC_DC_STATIC_STATUS,     8, 238, 414, 12
    PUSHBUTTON      "Start Copy...", IDC_DC_BTN_START,    8, 258,  90, 16
    PUSHBUTTON      "Cancel Copy",  IDC_DC_BTN_CANCEL,  102, 258,  80, 16
    PUSHBUTTON      "Close",        IDC_DC_BTN_CLOSE,   372, 258,  50, 16
END

// -------------------------------------------------------------------------
// IDD_BADSECTORSCAN  (CBadSectorScanDialog)
// IDC_BSS_STATIC_MAP is a placeholder LTEXT; OnInitDialog destroys it and
// creates the real CScanMapView at the same rect.
// -------------------------------------------------------------------------
IDD_BADSECTORSCAN DIALOGEX 0, 0, 400, 320
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX |
      WS_SIZEBOX | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Bad Sector Scan"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Drive:", IDC_STATIC, 7, 7, 29, 9
    COMBOBOX        IDC_BSS_COMBO_DRIVE, 7, 18, 386, 123, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    AUTORADIOBUTTON "Whole disk",       IDC_BSS_RADIO_WHOLE,   7, 38,  57, 11, WS_GROUP
    AUTORADIOBUTTON "Single partition", IDC_BSS_RADIO_PART,   70, 38,  80, 11
    AUTORADIOBUTTON "LBA range",        IDC_BSS_RADIO_RANGE, 155, 38,  74, 11
    PUSHBUTTON      "Choose Partition...", IDC_BSS_BTN_CHOOSE_PART,   7, 53,  80, 15
    LTEXT           "Start:",  IDC_BSS_STATIC_RANGE_START_LBL,  7, 55,  51, 10
    EDITTEXT        IDC_BSS_EDIT_RANGE_START,                  59, 54,  62, 12
    LTEXT           "Count:",  IDC_BSS_STATIC_RANGE_COUNT_LBL, 127, 55,  51, 10
    EDITTEXT        IDC_BSS_EDIT_RANGE_COUNT,                  179, 54,  67, 12
    LTEXT           "", IDC_BSS_STATIC_PART, 7, 71, 386, 10
    LTEXT           "Sector Map:", IDC_STATIC, 7, 86, 46, 9
    LTEXT           "", IDC_BSS_STATIC_MAP, 7, 96, 386, 62
    LTEXT           "", IDC_BSS_STATIC_STATUS, 7, 161, 386, 11
    LTEXT           "Bad Sectors:", IDC_STATIC, 7, 176, 46, 9
    CONTROL         "", IDC_BSS_LIST_BAD, "SysListView32",
                    LVS_REPORT|LVS_SHOWSELALWAYS|WS_BORDER|WS_CHILD|WS_VISIBLE|WS_TABSTOP,
                    7, 187, 386, 106
    PUSHBUTTON      "Start Scan",        IDC_BSS_BTN_START,    7, 299,  63, 16
    PUSHBUTTON      "Stop",              IDC_BSS_BTN_STOP,    75, 299,  63, 16
    PUSHBUTTON      "Attempt Repair...", IDC_BSS_BTN_REPAIR,  144, 299,  91, 16
    PUSHBUTTON      "Close",             IDC_BSS_BTN_CLOSE,   342, 299,  51, 16
END

