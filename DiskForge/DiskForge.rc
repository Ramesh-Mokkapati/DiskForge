// -------------------------------------------------------------------------
// IDD_EFIBOOT  (CEfiBootDialog)
// -------------------------------------------------------------------------
IDD_EFIBOOT DIALOGEX 0, 0, 366, 271
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX |
      WS_SIZEBOX | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "UEFI Boot Entry Manager"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_EB_LIST_ENTRIES, "SysListView32",
                    LVS_REPORT|LVS_SHOWSELALWAYS|WS_BORDER|WS_CHILD|WS_VISIBLE|WS_TABSTOP,
                    7, 7, 266, 217
    PUSHBUTTON      "Move Up",          IDC_EB_BTN_MOVE_UP,     274,   7, 85, 14
    PUSHBUTTON      "Move Down",        IDC_EB_BTN_MOVE_DOWN,   274,  23, 85, 14
    PUSHBUTTON      "Apply Order",      IDC_EB_BTN_APPLY_ORDER, 274,  39, 85, 14
    PUSHBUTTON      "Set as Next Boot", IDC_EB_BTN_SET_NEXT,    274,  69, 85, 14
    PUSHBUTTON      "Clear Next Boot",  IDC_EB_BTN_CLEAR_NEXT,  274,  85, 85, 14
    PUSHBUTTON      "Delete Entry",     IDC_EB_BTN_DELETE,      274, 114, 85, 14
    PUSHBUTTON      "Refresh",          IDC_EB_BTN_REFRESH,     274, 144, 85, 14
    LTEXT           "", IDC_EB_STATIC_STATUS, 7, 229, 352, 17
    PUSHBUTTON      "Close", IDC_EB_BTN_CLOSE, 307, 251, 51, 15
END

// -------------------------------------------------------------------------
