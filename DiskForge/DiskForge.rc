// DiskForge.rc - Application resources
#include "resource.h"
#include <winres.h>
#include "afxres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// MFC SDI document string (IDR_MAINFRAME)
// Format: title\nshortTitle\nfilterName\nfilterExt\nRegFileTypeId\nRegFileTypeName\nFilterName
STRINGTABLE
BEGIN
    IDR_MAINFRAME "DiskForge\nDiskForge\nDiskForge\n\n\nDiskForge.Document\nDiskForge Document"
END

// Minimal menu — required by CFrameWnd::LoadFrame (returns FALSE without one)
IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",  ID_APP_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About DiskForge...", ID_APP_ABOUT
    END
END

// -------------------------------------------------------------------------
// IDD_MAIN  (CDiskForgeDlg : CFormView)
// Style MUST be DS_SETFONT|WS_CHILD — CFormView requires this; CMainFrame
// provides the caption, borders and menu bar.
// -------------------------------------------------------------------------
// Right-pane content: hex viewer + drive/sector controls.
// Sidebar removed — navigation is now in the left splitter pane (CNavTreeView).
IDD_MAIN DIALOGEX 0, 0, 460, 560
STYLE DS_SETFONT | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // --- Drive-selection row (y=8)
    COMBOBOX        IDC_COMBO_DRIVES,    8,  8, 218, 200, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    PUSHBUTTON      "Refresh",           IDC_BTN_REFRESH,    234,  8,  90, 26
    PUSHBUTTON      "Open Drive",        IDC_BTN_OPEN,       334,  8, 100, 26

    // --- Drive info (y=44, h=48)
    LTEXT           "", IDC_STATIC_DRIVEINFO, 8, 44, 444, 48

    // --- Sector navigation row (y=104)
    LTEXT           "Sector #",          IDC_STATIC,          8, 108,  52, 14
    EDITTEXT        IDC_EDIT_SECTOR,                         64, 104,  80, 24, ES_NUMBER|ES_AUTOHSCROLL
    PUSHBUTTON      "Go to Sector",      IDC_BTN_GOTO,       148, 104,  80, 24
    PUSHBUTTON      "|<",                IDC_BTN_FIRST,      232, 104,  48, 24
    PUSHBUTTON      "<",                 IDC_BTN_PREV,       284, 104,  48, 24
    PUSHBUTTON      ">",                 IDC_BTN_NEXT,       336, 104,  48, 24
    PUSHBUTTON      ">|",               IDC_BTN_LAST,       388, 104,  48, 24

    // Sector-info label; LayoutControls repositions it to R-200, y=104
    LTEXT           "", IDC_STATIC_SECTOR, 152, 130, 284, 14

    // --- HexView placeholder; OnInitialUpdate destroys and replaces with CHexView
    LTEXT           "", IDC_HEXVIEW, 8, 140, 444, 350

    // --- Progress bar
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", PBS_SMOOTH|WS_CHILD|WS_VISIBLE, 8, 498, 444, 12

    // --- Status bar
    LTEXT           "", IDC_STATIC_STATUS, 8, 518, 444, 20
END

