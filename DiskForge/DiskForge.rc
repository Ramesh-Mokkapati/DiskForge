// -------------------------------------------------------------------------
// IDD_PARTITIONEDIT  (CPartitionEditDialog)
// -------------------------------------------------------------------------
IDD_PARTITIONEDIT DIALOGEX 0, 0, 434, 345
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX |
      WS_SIZEBOX | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Partition Editor"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Drive:", IDC_STATIC, 7, 7, 29, 9
    COMBOBOX        IDC_PE_COMBO_DRIVE, 38, 6, 343, 123, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    PUSHBUTTON      "Load Partitions", IDC_PE_BTN_LOAD, 386, 6, 41, 14

    CONTROL         "", IDC_PE_LIST_PARTITIONS, "SysListView32",
                    LVS_REPORT|LVS_SHOWSELALWAYS|LVS_SINGLESEL|WS_BORDER|WS_CHILD|WS_VISIBLE|WS_TABSTOP,
                    7, 26, 421, 98

    // --- MBR edit controls (left column) ---
    AUTOCHECKBOX    "Active/Bootable",   IDC_PE_CHK_MBR_ACTIVE,    7, 132, 91, 11
    LTEXT           "MBR Type:", IDC_STATIC,                        7, 146, 43,  9
    COMBOBOX        IDC_PE_COMBO_MBR_TYPE, 53, 144, 143, 123, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    AUTOCHECKBOX    "Hidden partition",  IDC_PE_CHK_MBR_HIDDEN,     7, 159, 91, 11

    // --- GPT edit controls (right column) ---
    LTEXT           "GPT Name:", IDC_STATIC, 206, 132, 40, 9
    EDITTEXT        IDC_PE_EDIT_GPT_NAME, 248, 129, 179, 14, ES_AUTOHSCROLL
    LTEXT           "GPT Type:", IDC_STATIC, 206, 146, 40, 9
    COMBOBOX        IDC_PE_COMBO_GPT_TYPE, 248, 144, 179, 123, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    AUTOCHECKBOX    "Legacy boot attribute",  IDC_PE_CHK_GPT_LEGACY_BOOT, 206, 159, 114, 11
    AUTOCHECKBOX    "No auto-assign letter",  IDC_PE_CHK_GPT_NO_LETTER,   206, 172, 114, 11

    // --- Apply / status ---
    PUSHBUTTON      "Apply Changes", IDC_PE_BTN_APPLY,    7, 190,  80, 17
    LTEXT           "", IDC_PE_STATIC_STATUS,              7, 213, 421, 22

    // --- Drive-letter assignment ---
    LTEXT           "Current letter:", IDC_STATIC,          7, 242,  57,  9
    LTEXT           "", IDC_PE_STATIC_CUR_LETTER,           66, 242,  34,  9
    LTEXT           "Assign letter:", IDC_STATIC,            7, 256,  46,  9
    COMBOBOX        IDC_PE_COMBO_NEW_LETTER,                55, 254,  46, 123, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    PUSHBUTTON      "Assign Letter",  IDC_PE_BTN_ASSIGN_LETTER, 105, 254,  74, 16
    PUSHBUTTON      "Remove Letter",  IDC_PE_BTN_REMOVE_LETTER, 184, 254,  74, 16

    // --- Bottom action buttons ---
    PUSHBUTTON      "Delete Partition",  IDC_PE_BTN_DELETE,   7, 321,  80, 17
    PUSHBUTTON      "Extend Partition",  IDC_PE_BTN_EXTEND,  93, 321,  80, 17
    PUSHBUTTON      "Close",             IDC_PE_BTN_CLOSE,  370, 321,  57, 17
END

