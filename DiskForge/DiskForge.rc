// -------------------------------------------------------------------------
IDD_LOSTPARTITION DIALOGEX 0, 0, 411, 283
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX |
      WS_SIZEBOX | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Lost Partition Search"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Drive:", IDC_STATIC, 7, 7, 29, 9
    COMBOBOX        IDC_LP_COMBO_DRIVE, 38, 6, 366, 123, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    LTEXT           "", IDC_LP_STATIC_FREESPACE,    7,  25, 398, 20
    CONTROL         "", IDC_LP_LIST_CANDIDATES, "SysListView32",
                    LVS_REPORT|LVS_SHOWSELALWAYS|WS_BORDER|WS_CHILD|WS_VISIBLE|WS_TABSTOP,
                    7, 48, 398, 174
    CONTROL         "", IDC_LP_PROGRESS, "msctls_progress32", PBS_SMOOTH|WS_CHILD|WS_VISIBLE,
                    7, 226, 398, 11
    LTEXT           "", IDC_LP_STATIC_STATUS, 7, 241, 398, 17
    PUSHBUTTON      "Start Search", IDC_LP_BTN_START,    7, 262,  63, 16
    PUSHBUTTON      "Stop",         IDC_LP_BTN_STOP,    75, 262,  63, 16
    PUSHBUTTON      "Close",        IDC_LP_BTN_CLOSE,  353, 262,  51, 16
END

// -------------------------------------------------------------------------
// IDD_FILERECOVERY  (CFileRecoveryDialog)
// -------------------------------------------------------------------------
IDD_FILERECOVERY DIALOGEX 0, 0, 400, 320
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX |
      WS_SIZEBOX | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Recover Deleted Files"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Drive:", IDC_STATIC, 7, 7, 29, 9
    COMBOBOX        IDC_FR_COMBO_DRIVE, 38, 6, 269, 123, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    PUSHBUTTON      "Choose Partition...", IDC_FR_BTN_CHOOSE_PART, 313, 6, 80, 14
    LTEXT           "", IDC_FR_STATIC_PART, 7, 23, 386, 10
    LTEXT           "Custom LBA Start:", IDC_STATIC, 7, 38, 69, 9
    EDITTEXT        IDC_FR_EDIT_CUSTOM_LBA, 78, 36, 78, 12, ES_NUMBER|ES_AUTOHSCROLL
    PUSHBUTTON      "Open Root...", IDC_FR_BTN_OPEN, 161, 36, 74, 14
    CONTROL         "", IDC_FR_TREE, "SysTreeView32",
                    TVS_HASLINES|TVS_HASBUTTONS|TVS_LINESATROOT|TVS_SHOWSELALWAYS|WS_BORDER|WS_CHILD|WS_VISIBLE|WS_TABSTOP,
                    7, 54, 386, 207
    LTEXT           "", IDC_FR_STATIC_INFO, 7, 265, 386, 17
    PUSHBUTTON      "Recover Selected...", IDC_FR_BTN_RECOVER,    7, 286, 103, 15
    LTEXT           "", IDC_FR_STATIC_STATUS,                   115, 288, 278, 12
    PUSHBUTTON      "Close", IDC_FR_BTN_CLOSE, 342, 304, 51, 16
END

